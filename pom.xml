<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>br.dev.miguelsanzbr.radar</groupId>
  <artifactId>radar-licitacoes</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>radar-licitacoes</name>
  <description>Radar de licitacoes publicas a partir do PNCP</description>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <modules>
    <module>contracts</module>
    <module>core</module>
    <module>tools/pncp-probe</module>
    <module>tools/synth</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <spring-modulith.version>2.1.2</spring-modulith.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <testcontainers-keycloak.version>4.4.0</testcontainers-keycloak.version>
    <resilience4j.version>2.4.0</resilience4j.version>
    <!-- why: the image build has no Docker daemon, so it skips codegen and compiles the sources generated on the host (make image) -->
    <jooq.codegen.skip>false</jooq.codegen.skip>
    <!-- why: 3.x moved to Jackson 3 and breaks openapi-request-validator 3.0.0, which still calls the Jackson 2 API of 2.x -->
    <json-schema-validator.version>2.0.1</json-schema-validator.version>
    <jqwik.version>1.10.2</jqwik.version>
    <archunit.version>1.5.1</archunit.version>
    <wiremock.version>3.13.2</wiremock.version>
    <togglz.version>4.6.4</togglz.version>
    <openapi-generator.version>7.26.0</openapi-generator.version>
    <openapi-request-validator.version>3.0.0</openapi-request-validator.version>
    <!-- why: a mesma linha 3.x do registry do compose (infra/compose/docker-compose.yml, perfil layer3) -->
    <apicurio.version>3.3.3</apicurio.version>
    <playwright.version>1.64.0</playwright.version>
    <gatling.version>3.15.1</gatling.version>
    <gatling-maven-plugin.version>4.21.12</gatling-maven-plugin.version>

    <!-- why: testes com @Tag("bench") medem tempo, @Tag("chaos") derruba infraestrutura, @Tag("cdc") sobe tres contêineres e uma imagem de 2,4 GB @Tag("avro") sobe o Apicurio, @Tag("messaging") projeta 10 mil eventos entre consumidores que entram e saem e @Tag("e2e") abre um navegador: ficam fora do verify; -Pbench, -Pchaos, -Pcdc, -Pavro e -Pmessaging trocam os dois filtros -->
    <test.groups></test.groups>
    <test.excluded.groups>bench,chaos,compat,cdc,avro,messaging,e2e</test.excluded.groups>

    <!-- why: o JaCoCo prepende o agente a este valor; o perfil jfr acrescenta flags via @{argLine} -->
    <argLine></argLine>

    <jacoco.version>0.8.15</jacoco.version>
    <pitest-maven.version>1.30.1</pitest-maven.version>
    <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
    <spotless.version>3.10.4</spotless.version>
    <google-java-format.version>1.36.0</google-java-format.version>
    <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
    <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-bom</artifactId>
        <version>${resilience4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- GHSA-mcr4-qmvw-px4g: kafka-clients traz 1.11.2; remover quando o Kafka gerenciado trouxer >= 1.11.4 -->
      <dependency>
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>1.11.4</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <groups>${test.groups}</groups>
            <excludedGroups>${test.excluded.groups}</excludedGroups>
            <includes>
              <include>**/*Test.java</include>
            </includes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <groups>${test.groups}</groups>
            <excludedGroups>${test.excluded.groups}</excludedGroups>
            <includes>
              <include>**/*IT.java</include>
            </includes>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!--
          Gate de cobertura: LINE e BRANCH em 100% no bundle. prepare-agent injeta o agente em
          surefire e failsafe (propriedade argLine) e os dois gravam no mesmo jacoco.exec, entao
          unidade e integracao contam juntas. A verificacao e por modulo; o report-aggregate e o
          check agregado entram junto com o segundo modulo.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
        </plugin>

        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
            <execution>
              <id>check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>1.00</minimum>
                      </limit>
                      <limit>
                        <counter>BRANCH</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>1.00</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.pitest</groupId>
          <artifactId>pitest-maven</artifactId>
          <version>${pitest-maven.version}</version>
          <dependencies>
            <dependency>
              <groupId>org.pitest</groupId>
              <artifactId>pitest-junit5-plugin</artifactId>
              <version>${pitest-junit5-plugin.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <mutationThreshold>85</mutationThreshold>
            <coverageThreshold>100</coverageThreshold>
            <timestampedReports>false</timestampedReports>
            <excludedGroups>
              <param>bench</param>
              <param>chaos</param>
              <param>compat</param>
              <param>cdc</param>
              <param>avro</param>
              <param>messaging</param>
              <param>e2e</param>
            </excludedGroups>
          </configuration>
        </plugin>

        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <googleJavaFormat>
                <version>${google-java-format.version}</version>
              </googleJavaFormat>
            </java>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>check</goal>
              </goals>
              <phase>verify</phase>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-maven-plugin.version}</version>
          <configuration>
            <effort>Max</effort>
            <threshold>Low</threshold>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>check</goal>
              </goals>
              <phase>verify</phase>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.cyclonedx</groupId>
          <artifactId>cyclonedx-maven-plugin</artifactId>
          <version>${cyclonedx-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Declarado antes do jacoco para a execucao do perfil require-coverage-data rodar antes do check. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <inherited>false</inherited>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>makeAggregateBom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!--
        ./mvnw -Pe2e verify -pl core -am -Dit.test=SearchUiE2EIT: a interface no Chromium (Playwright), contra a
        aplicação inteira em processo com Postgres de teste. ./mvnw -Pe2e verify -pl e2e: o compose de
        infra/compose (precisa da imagem, make image). Os dois rodam só os testes com @Tag("e2e"), fora do
        verify padrão e sem o gate de cobertura.
      -->
      <id>e2e</id>
      <modules>
        <module>e2e</module>
      </modules>
      <properties>
        <test.groups>e2e</test.groups>
        <test.excluded.groups></test.excluded.groups>
      </properties>
      <build>
        <plugins>
          <plugin>
            <!-- O agente continua ligado (o enforcer exige jacoco.exec); so o gate de 100% sai. -->
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>check</id>
                <configuration>
                  <skip>true</skip>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!--
        make bench (scripts/bench.sh): as simulacoes Gatling S1 a S6 de perf/ contra o compose em execucao.
        Fora do build padrao: nao ha classe de producao nem teste de unidade ali, so cenarios de carga.
      -->
      <id>perf</id>
      <modules>
        <module>perf</module>
      </modules>
    </profile>
    <profile>
      <!-- ./mvnw -Pimage verify: exige a imagem radar-licitacoes:local (make image); fora do build padrao. -->
      <id>image</id>
      <modules>
        <module>it-image</module>
      </modules>
    </profile>
    <profile>
      <!--
        ./mvnw -Pbench test -pl core -am -Dtest=VirtualThreadsBenchTest: roda so os testes com
        @Tag("bench") (ex.: docs/benchmarks/jvm/virtual-threads.md). Sem o gate de cobertura: nao e verify.
        Os ITs com @Tag("bench") (docs/benchmarks/cdc) rodam no failsafe:
        ./mvnw -Pbench verify -pl core -am -Dtest=NoSuch -Dit.test=PollingVsDebeziumBenchIT -Dsurefire.failIfNoSpecifiedTests=false
      -->
      <id>bench</id>
      <properties>
        <test.groups>bench</test.groups>
        <test.excluded.groups></test.excluded.groups>
      </properties>
      <build>
        <plugins>
          <plugin>
            <!-- O agente continua ligado (o enforcer exige jacoco.exec ao fim do verify); so o gate de 100% sai. -->
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>check</id>
                <configuration>
                  <skip>true</skip>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!--
        ./mvnw -Pchaos verify -pl core -am -Dit.test=ChaosIT (make chaos): roda so os testes com
        @Tag("chaos"), que sobem Postgres e Kafka proprios atras do Toxiproxy e os derrubam. Fora do
        verify padrao e sem o gate de cobertura.
      -->
      <id>chaos</id>
      <properties>
        <test.groups>chaos</test.groups>
        <test.excluded.groups></test.excluded.groups>
      </properties>
      <build>
        <plugins>
          <plugin>
            <!-- O agente continua ligado (o enforcer exige jacoco.exec); so o gate de 100% sai. -->
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>check</id>
                <configuration>
                  <skip>true</skip>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!--
        ./mvnw -Pcompat verify -pl core -am -Dit.test=PreviousReleaseCompatIT (make compat): roda so os
        testes com @Tag("compat"), que sobem a imagem radar-licitacoes:prev (a release anterior)
        contra o schema atual. Fora do verify padrao e sem o gate de cobertura.
      -->
      <id>compat</id>
      <properties>
        <test.groups>compat</test.groups>
        <test.excluded.groups></test.excluded.groups>
      </properties>
      <build>
        <plugins>
          <plugin>
            <!-- O agente continua ligado (o enforcer exige jacoco.exec); so o gate de 100% sai. -->
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>check</id>
                <configuration>
                  <skip>true</skip>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!--
        ./mvnw -Pcdc verify -pl core -am -Dit.test=CdcEquivalenceIT (make cdc-test): roda so os testes com
        @Tag("cdc"), que sobem Postgres (wal_level=logical), Kafka e o Debezium Connect do compose e passam
        o relay e o CDC pelas mesmas asserções (ADR-0018). Fora do verify padrao e sem o gate de cobertura.
      -->
      <id>cdc</id>
      <properties>
        <test.groups>cdc</test.groups>
        <test.excluded.groups></test.excluded.groups>
      </properties>
      <build>
        <plugins>
          <plugin>
            <!-- O agente continua ligado (o enforcer exige jacoco.exec); so o gate de 100% sai. -->
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>check</id>
                <configuration>
                  <skip>true</skip>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!--
        ./mvnw -Pmessaging verify -pl core -am -Dit.test='ProjectorRebalanceIT,ProjectorBackpressureIT,ProjectorOrderingIT' (make messaging-test):
        roda so os testes com @Tag("messaging"): rebalance do grupo do projetor durante 10 mil eventos, pausa por
        backpressure e ordem por chave (ADR-0026). Usam o Kafka e o Postgres compartilhados. Fora do verify padrao e
        sem o gate de cobertura.
      -->
      <id>messaging</id>
      <properties>
        <test.groups>messaging</test.groups>
        <test.excluded.groups></test.excluded.groups>
      </properties>
      <build>
        <plugins>
          <plugin>
            <!-- O agente continua ligado (o enforcer exige jacoco.exec); so o gate de 100% sai. -->
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>check</id>
                <configuration>
                  <skip>true</skip>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!--
        ./mvnw -Pavro verify -pl core -am -Dit.test='SchemaEvolutionIT,AvroModeIT,AvroDlqIT' (make avro-test): roda so os
        testes com @Tag("avro"), que sobem o Apicurio Registry (ADR-0024) alem do Kafka e do Postgres compartilhados.
        Fora do verify padrao e sem o gate de cobertura.
      -->
      <id>avro</id>
      <properties>
        <test.groups>avro</test.groups>
        <test.excluded.groups></test.excluded.groups>
      </properties>
      <build>
        <plugins>
          <plugin>
            <!-- O agente continua ligado (o enforcer exige jacoco.exec); so o gate de 100% sai. -->
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>check</id>
                <configuration>
                  <skip>true</skip>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!--
        ./mvnw -Pjfr verify -pl core -am -Dit.test=BackfillIT: os ITs rodam sob uma gravacao JFR
        chamada "pinning" (jdk.VirtualThreadPinned a partir de 20 ms), tambem nos testes de unidade. O
        teste de pinning do BackfillIT le o snapshot dela; os arquivos finais ficam em
        core/target/pinning.jfr (ITs) e pinning-unit.jfr (unidade).
        @{argLine} e o agente do JaCoCo, resolvido so na hora de iniciar o failsafe.
      -->
      <id>jfr</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-failsafe-plugin</artifactId>
              <configuration>
                <argLine>@{argLine} -XX:FlightRecorderOptions=stackdepth=256 -XX:StartFlightRecording=name=pinning,filename=${project.build.directory}/pinning.jfr,dumponexit=true,jdk.VirtualThreadPinned#threshold=20ms</argLine>
              </configuration>
            </plugin>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <configuration>
                <argLine>@{argLine} -XX:FlightRecorderOptions=stackdepth=256 -XX:StartFlightRecording=name=pinning,filename=${project.build.directory}/pinning-unit.jfr,dumponexit=true,jdk.VirtualThreadPinned#threshold=20ms</argLine>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
    <profile>
      <!--
        O check do JaCoCo passa em silencio quando jacoco.exec nao existe. Todo modulo com codigo
        de producao precisa ter rodado testes, a menos que -DskipTests ou -Dmaven.test.skip=true.
      -->
      <id>require-coverage-data</id>
      <activation>
        <file>
          <exists>${basedir}/src/main/java</exists>
        </file>
        <property>
          <name>!skipTests</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>require-jacoco-exec</id>
                <phase>verify</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <skip>${maven.test.skip}</skip>
                  <rules>
                    <requireFilesExist>
                      <files>
                        <file>${project.build.directory}/jacoco.exec</file>
                      </files>
                      <message>jacoco.exec ausente: modulo com codigo de producao sem testes executados, gate de cobertura nao se aplica.</message>
                    </requireFilesExist>
                  </rules>
                  <fail>true</fail>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- ./mvnw -Pmutation verify: fora do verify padrao para o build normal continuar rapido. -->
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <executions>
              <execution>
                <id>mutation-coverage</id>
                <phase>verify</phase>
                <goals>
                  <goal>mutationCoverage</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
