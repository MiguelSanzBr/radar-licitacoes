{
  "type": "record",
  "name": "AlertMatched",
  "namespace": "br.dev.miguelsanzbr.radar.events",
  "doc": "A saved search matched a procurement for the first time. Key of the topic: subscriberId.",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "UUID v7, unique per event."
    },
    {
      "name": "eventType",
      "type": "string"
    },
    {
      "name": "schemaVersion",
      "type": "int"
    },
    {
      "name": "aggregateType",
      "type": "string"
    },
    {
      "name": "aggregateId",
      "type": "string",
      "doc": "Also the Kafka record key."
    },
    {
      "name": "aggregateVersion",
      "type": "long"
    },
    {
      "name": "occurredAt",
      "type": "string",
      "doc": "ISO-8601 instant."
    },
    {
      "name": "traceparent",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "W3C trace context; null until tracing is on."
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "AlertMatchedPayload",
        "fields": [
          {
            "name": "savedSearchId",
            "type": "string"
          },
          {
            "name": "subscriberId",
            "type": "string"
          },
          {
            "name": "procurementId",
            "type": "string"
          },
          {
            "name": "frequency",
            "type": "string",
            "doc": "INSTANT or DAILY."
          },
          {
            "name": "objectDescription",
            "type": "string",
            "doc": "First 300 characters of the object description."
          },
          {
            "name": "organName",
            "type": "string"
          },
          {
            "name": "uf",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "municipality",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "estimatedValue",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Decimal string with two places."
          },
          {
            "name": "proposalClosingAt",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "ISO-8601 instant."
          },
          {
            "name": "detailPath",
            "type": "string",
            "doc": "Path of the procurement page."
          }
        ]
      }
    }
  ]
}
