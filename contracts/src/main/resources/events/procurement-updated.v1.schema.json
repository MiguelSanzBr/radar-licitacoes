{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar.miguelsanzbr.dev/schemas/events/procurement-updated.v1.schema.json",
  "title": "ProcurementUpdated v1",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ProcurementUpdated"
    },
    "schemaVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "Procurement"
    },
    "aggregateId": {
      "$ref": "procurement-snapshot.v1.schema.json#/$defs/procurementId"
    },
    "payload": {
      "type": "object",
      "required": [
        "aggregateId",
        "occurredAt",
        "snapshot",
        "changedFields"
      ],
      "additionalProperties": false,
      "properties": {
        "aggregateId": {
          "$ref": "procurement-snapshot.v1.schema.json#/$defs/procurementId"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot": {
          "$ref": "procurement-snapshot.v1.schema.json"
        },
        "changedFields": {
          "description": "Snapshot fields whose value differs from the previous state, sorted by name.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "awardedValue",
              "disputeMode",
              "estimatedValue",
              "legalBasis",
              "modality",
              "objectDescription",
              "organ",
              "pncpUpdatedAt",
              "proposalWindow",
              "publishedAt",
              "situation",
              "srp",
              "unit"
            ]
          }
        }
      }
    }
  }
}
