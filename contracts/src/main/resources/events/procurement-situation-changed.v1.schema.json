{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar.miguelsanzbr.dev/schemas/events/procurement-situation-changed.v1.schema.json",
  "title": "ProcurementSituationChanged v1",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
