        "aggregateId": {
          "$ref": "procurement-snapshot.v1.schema.json#/$defs/procurementId"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "from": {
          "$ref": "procurement-snapshot.v1.schema.json#/$defs/idName"
        },
        "to": {
          "$ref": "procurement-snapshot.v1.schema.json#/$defs/idName"
        },
        "pncpUpdatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "unexpected": {
          "description": "True when the state machine does not allow the transition.",
          "type": "boolean"
        }
      }
    }
