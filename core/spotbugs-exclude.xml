<?xml version="1.0" encoding="UTF-8"?>
<!-- Codigo gerado (OpenAPI e jOOQ) e injecao de ports; ver docs/coverage-exclusions.md. -->
<FindBugsFilter>
  <Match>
    <Class name="~br\.dev\.miguelsanzbr\.radar\.api\.generated\..*"/>
  </Match>
  <Match>
    <Class name="~br\.dev\.miguelsanzbr\.radar\.search\.adapter\.out\.jooq\.generated\..*"/>
  </Match>
  <!-- Casos de uso guardam as ports injetadas (interfaces); nao e vazamento de estado mutavel. -->
  <Match>
    <Package name="br.dev.miguelsanzbr.radar.alerts.application"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- O valor devolvido no cabecalho so passa se casar com [A-Za-z0-9._-]{1,64}; o analisador nao enxerga o regex. -->
  <Match>
    <Class name="br.dev.miguelsanzbr.radar.observability.CorrelationIdFilter"/>
    <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/>
  </Match>
</FindBugsFilter>
