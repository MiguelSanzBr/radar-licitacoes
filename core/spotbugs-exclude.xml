<?xml version="1.0" encoding="UTF-8"?>
<!-- Codigo gerado (OpenAPI e jOOQ) e injecao de ports; ver docs/coverage-exclusions.md. -->
<FindBugsFilter>
  <Match>
    <Class name="~br\.dev\.miguelsanzbr\.radar\.api\.generated\..*"/>
  </Match>
  <Match>
    <Class name="~br\.dev\.miguelsanzbr\.radar\.search\.adapter\.out\.jooq\.generated\..*"/>
  </Match>
  <!-- Casos de uso guardam as ports injetadas (interfaces); nao e vazamento de estado mutavel. -->
  <Match>
    <Package name="br.dev.miguelsanzbr.radar.alerts.application"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- O OutboxWriter guarda o JdbcTemplate injetado (colaborador compartilhado, nao estado mutavel); o construtor e publico para os testes de contrato montarem o caminho real. -->
  <Match>
    <Class name="br.dev.miguelsanzbr.radar.outbox.OutboxWriter"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Package name="br.dev.miguelsanzbr.radar.identity.application"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- O RedisRateLimiter guarda o StringRedisTemplate injetado (colaborador compartilhado, nao estado mutavel). -->
  <Match>
    <Class name="br.dev.miguelsanzbr.radar.identity.adapter.out.redis.RedisRateLimiter"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Package name="br.dev.miguelsanzbr.radar.search.application"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- O valor devolvido no cabecalho so passa se casar com [A-Za-z0-9._-]{1,64}; o analisador nao enxerga o regex. -->
  <Match>
    <Class name="br.dev.miguelsanzbr.radar.observability.CorrelationIdFilter"/>
    <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/>
  </Match>
  <!-- PageFetcher devolve ao chamador a mesma excecao nao verificada que a busca da pagina lancou (a funcao de busca nao lanca excecao verificada); o analisador nao enxerga isso. -->
  <Match>
    <Class name="~br\.dev\.miguelsanzbr\.radar\.ingest\.application\.PageFetcher\$Pages"/>
    <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE,THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
  </Match>
</FindBugsFilter>
