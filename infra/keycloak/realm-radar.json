{
  "realm": "radar",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "supplier",
        "description": "Fornecedor: buscas salvas, alertas e chaves de API"
      },
      {
        "name": "operator",
        "description": "Operador: rotas /ops e endpoints do actuator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "radar-web",
      "name": "Radar de Licitações (páginas)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "radar-web-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080/"
      },
      "protocolMappers": [
        {
          "name": "radar-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "radar-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm roles in id token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "radar-api",
      "name": "Radar de Licitações (API)",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "admin-cli",
      "name": "${client_admin-cli}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "fornecedor",
      "enabled": true,
      "email": "fornecedor@example.com",
      "emailVerified": true,
      "firstName": "Fornecedor",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "fornecedor",
          "temporary": false
        }
      ],
      "realmRoles": [
        "supplier"
      ]
    },
    {
      "username": "operador",
      "enabled": true,
      "email": "operador@example.com",
      "emailVerified": true,
      "firstName": "Operador",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "operador",
          "temporary": false
        }
      ],
      "realmRoles": [
        "operator"
      ]
    }
  ]
}
