# Copie para .env (fora do git) e troque os valores fora do ambiente local.
# `make up` faz a copia se o .env nao existir; a senha do banco fica em secrets/db_password
# e a do papel radar_read_writer em secrets/read_writer_password (geradas ao acaso por
# scripts/compose-init.sh, tambem fora do git). A tag da imagem vem de RADAR_TAG no ambiente (padrao local).

# Keycloak (realm importado de infra/keycloak/realm-radar.json, porta 8180 no ambiente local)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=troque-me
# O navegador e a aplicacao usam esta mesma URL como emissor dos tokens (KC_HOSTNAME do Keycloak);
# a aplicacao busca as chaves e troca o codigo por token direto em http://keycloak:8080.
RADAR_OIDC_ISSUER=http://localhost:8180/realms/radar
# Segredo do cliente radar-web. O valor abaixo e o padrao de desenvolvimento gravado no realm.
RADAR_WEB_CLIENT_SECRET=radar-web-dev-secret

# Usuarios de desenvolvimento do realm (senhas padrao, so para uso local):
#   fornecedor / fornecedor  (papel supplier)
#   operador   / operador    (papel operator)
# Cliente de automacao (make seed e e2e): radar-ops-cli / radar-ops-dev-secret (client credentials,
# papel operator).

# Grafana do otel-lgtm: admin / admin (padrao da imagem)
